# Copy to .env and adjust. Everything is optional for local development.

# ---------- core ----------
# Leave MONGODB_URI empty to auto-start an in-memory MongoDB (data is lost on restart).
# For a real database: MONGODB_URI=mongodb://127.0.0.1:27017/propfinder  (or a MongoDB Atlas URI)
MONGODB_URI=
PORT=5000
# REQUIRED in production. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production
# Front-end origin(s), comma-separated. Used for CORS, sitemap URLs and reset links.
CLIENT_URL=http://localhost:5173
# NODE_ENV=production hides development-only helpers (OTP codes, reset links in responses).
NODE_ENV=development
# Load demo data when the database is empty (demo records are labelled isDemo).
AUTO_SEED=true
# Set RATE_LIMIT=off only for local load testing.
RATE_LIMIT=on

# ---------- AI provider (optional) ----------
# Without a key, analysis narratives, comparisons, listing drafts and the chatbot use
# deterministic rule-based logic built from the same retrieved data.
# AI_PROVIDER: anthropic | openai
AI_PROVIDER=anthropic
AI_API_KEY=
# Defaults: claude-opus-5-5 (anthropic) / gpt-4o-mini (openai)
AI_MODEL=
# Anthropic only: low | medium | high (default low — fast, cheap chat answers)
AI_EFFORT=low
# Anthropic only: server-side refusal fallback is on by default; set to "off" to disable.
AI_FALLBACKS=
AI_TIMEOUT_MS=45000

# ---------- nearby facilities ----------
# overpass (default, OpenStreetMap, no key) | google (needs GOOGLE_MAPS_API_KEY) | none
NEARBY_PROVIDER=overpass
# Optional comma-separated Overpass endpoints (defaults to public mirrors). For production
# traffic, run your own Overpass instance or use a commercial provider.
OVERPASS_URL=
GOOGLE_MAPS_API_KEY=
NEARBY_CACHE_DAYS=30
NEARBY_TIMEOUT_MS=60000
# How long an API request waits for a fresh lookup before returning "pending" (ms).
NEARBY_WAIT_MS=3000
PLACES_USER_AGENT=PropFinder/2.0

# ---------- routing / travel time (optional) ----------
# Set ROUTING_PROVIDER=osrm and OSRM_URL to your OSRM server to add road distance and drive time.
# The public OSRM demo server is not for production use.
ROUTING_PROVIDER=
OSRM_URL=

# ---------- geocoding ----------
# nominatim (default, OpenStreetMap, max ~1 request/second) | none
GEOCODER=nominatim
NOMINATIM_URL=

# ---------- reviews ----------
# flagged (default): clean reviews publish immediately, flagged ones wait for moderation
# all: every review waits for a moderator
REVIEW_MODERATION=flagged

# ---------- storage ----------
# Public listing photos and private documents (RERA certificates, plans).
UPLOADS_DIR=
PRIVATE_UPLOADS_DIR=

# ---------- seeding ----------
# The demo admin (admin@propfinder.in / Passw0rd!) is skipped in production unless this is true.
SEED_ADMIN=false
